{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Updates per second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (instance, mode) (rate(mxl_scopes_updates_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{instance}} {{mode}}",
          "refId": "A"
        },
        {
          "expr": "rate(mxl_scopes_updates_skipped_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} skipped",
          "refId": "B"
        },
        {
          "expr": "rate(mxl_scopes_updates_torn_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} torn",
          "refId": "C"
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Output grains: late and missed per second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(mxl_scopes_output_frames_late_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} late",
          "refId": "A"
        },
        {
          "expr": "rate(mxl_scopes_output_frames_missed_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} missed",
          "refId": "B"
        },
        {
          "expr": "rate(mxl_scopes_output_frames_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} written",
          "refId": "C"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "Analyse and render (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(mxl_scopes_analyse_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} analyse",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(mxl_scopes_analyse_cpu_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} analyse CPU",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(mxl_scopes_render_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{instance}} render",
          "refId": "C"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Input state",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "mxl_scopes_input_state{instance=~\"$instance\"} == 1",
          "legendFormat": "{{instance}} {{state}}",
          "refId": "A"
        },
        {
          "expr": "rate(mxl_scopes_input_resyncs_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} resyncs/s",
          "refId": "B"
        },
        {
          "expr": "rate(mxl_scopes_accumulate_dropped_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}} accumulate dropped/s",
          "refId": "C"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "title": "Luma (codes)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "mxl_scopes_luma_min_code{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} min",
          "refId": "A"
        },
        {
          "expr": "mxl_scopes_luma_mean_code{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} mean",
          "refId": "B"
        },
        {
          "expr": "mxl_scopes_luma_max_code{instance=~\"$instance\"}",
