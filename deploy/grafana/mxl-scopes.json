    {
      "title": "Out of range and gamut (share)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "mxl_scopes_luma_below_legal_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} luma < 64",
          "refId": "A"
        },
        {
          "expr": "mxl_scopes_luma_above_legal_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} luma > 940",
          "refId": "B"
        },
        {
          "expr": "mxl_scopes_chroma_out_of_range_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} Cb/Cr out of range",
          "refId": "C"
        },
        {
          "expr": "mxl_scopes_rgb_out_of_gamut_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} R'G'B' out of gamut",
          "refId": "D"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
